# Reference only: review-code-ai reads process environment variables but does
# not load this file automatically. Keep real values in a secret manager or
# protected/masked CI variables. Never commit a populated .env file.

# GitLab
GITLAB_API_URL=https://gitlab.com/api/v4
ALLOW_PRIVATE_API_URLS=false
GITLAB_ACCESS_TOKEN=
# Compatibility alias: GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_MERGE_REQUEST_ID=

# Select one provider by passing --mode openai or --mode gemini.

# OpenAI-compatible provider
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Compatibility alias: OPENAI_ACCESS_TOKEN=
OPENAI_MODEL=
OPENAI_ORGANIZATION_ID=

# Gemini provider
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
# Compatibility alias: GEMINI_ACCESS_TOKEN=
GEMINI_MODEL=

# General model compatibility overrides
CUSTOM_MODEL=
MODEL=

# For security profiles, pass one of these CLI values:
# --review-profile standard
# --review-profile security
# --review-profile wordpress-security
